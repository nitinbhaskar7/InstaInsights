<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:titleTextColor="@color/text_primary" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Loading state -->
    <LinearLayout
        android:id="@+id/layoutLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminateTint="@color/colorPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Analysing your post…"
            android:textSize="14sp"
            android:textColor="@color/text_secondary" />

    </LinearLayout>

    <!-- Error state -->
    <LinearLayout
        android:id="@+id/layoutError"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <TextView
            android:id="@+id/tvErrorMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:gravity="center" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Retry"
            app:cornerRadius="24dp" />

    </LinearLayout>

    <!-- Main scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/layoutContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Post header: views here are accessed DIRECTLY as binding.ivPostThumbnail
                 because card_post_header.xml root is a merge or because we inline
                 the header views below instead of using include.
                 Since we need direct binding access, the header views are written
                 inline here — no <include> for the header. -->

            <!-- ══ Post header (inline — no include, so binding.xyz works directly) ══ -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/surface">

                <!-- Full-width thumbnail -->
                <ImageView
                    android:id="@+id/ivPostThumbnail"
                    android:layout_width="match_parent"
                    android:layout_height="260dp"
                    android:scaleType="centerCrop"
                    android:background="@color/divider"
                    android:contentDescription="@string/johndoe" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Type badge + timestamp row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:id="@+id/tvMediaType"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Photo"
                            android:textSize="11sp"
                            android:textColor="@color/colorPrimary"
                            android:background="@drawable/bg_type_badge"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/tvTimestamp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary" />

                    </LinearLayout>

                    <!-- Caption -->
                    <TextView
                        android:id="@+id/tvCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:maxLines="3"
                        android:ellipsize="end"
                        android:lineSpacingMultiplier="1.4" />

                    <!-- Like + comment quick stats -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_favorite_border"
                            app:tint="@color/colorAccent"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/tvLikeCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary"
                            android:text="0" />

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginStart="16dp"
                            android:src="@drawable/ic_comment"
                            app:tint="@color/text_secondary"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/tvCommentCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary"
                            android:text="0" />

                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Divider strip between header and cards -->
            <View
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:background="@color/background" />

            <!-- ══ Cards section ══ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Content stats -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Content stats"
                    android:layout_marginBottom="10dp"
                    style="@style/TextAppearance.InstaInsights.SectionTitle" />

                <!--  android:id is REQUIRED for ViewBinding sub-binding to work -->
                <include
                    android:id="@+id/cardContentStats"
                    layout="@layout/card_content_stats" />

                <!-- Performance -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Performance"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="10dp"
                    style="@style/TextAppearance.InstaInsights.SectionTitle" />

                <include
                    android:id="@+id/cardPerformance"
                    layout="@layout/card_performance" />

                <!-- Reel analytics — hidden by default, shown in code for VIDEO posts -->
                <LinearLayout
                    android:id="@+id/sectionReel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Reel analytics"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="10dp"
                        style="@style/TextAppearance.InstaInsights.SectionTitle" />

                    <include
                        android:id="@+id/cardReelStats"
                        layout="@layout/card_reel_stats" />

                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Automation"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="10dp"
                    style="@style/TextAppearance.InstaInsights.SectionTitle" />

                <include
                    android:id="@+id/cardPostSettings"
                    layout="@layout/card_post_settings" />

                <!-- Comment sentiment -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Comment sentiment"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="10dp"
                    style="@style/TextAppearance.InstaInsights.SectionTitle" />

                <include
                    android:id="@+id/cardSentiment"
                    layout="@layout/card_sentiment" />

                <!-- Bottom padding so last card isn't flush against the screen edge -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="24dp" />

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>